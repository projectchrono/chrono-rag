# chrono-rag environment file (optional).
#
# The web backend (chrono_rag.webapp) loads this via python-dotenv at startup.
# For the CLI, set these as ordinary environment variables instead.
# Copy to `.env` and fill in what you use; `.env` is gitignored.

# --- Cloud answer LLM (either one; only needed for `ask` / the web app) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Or a free local answer LLM (any OpenAI-compatible server) ---
# CHRONO_RAG_LLM_PROVIDER=local
# CHRONO_RAG_LLM_BASE_URL=http://localhost:13305/v1
# CHRONO_RAG_LLM_MODEL=Qwen2.5-Coder-32B-Instruct-GGUF

# --- Paths (defaults usually fine) ---
# CHRONO_RAG_INDEX=            # index folder (default: <repo>/index)
# CHRONO_RAG_EXTRA_INDEX=      # optional supplemental index(es), os.pathsep-separated
